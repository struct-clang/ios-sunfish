+/* True when the ADT root is the Pixel 4a (tools/mkadt.py --device sunfish). */
+static bool
+touch_board_sunfish(void)
+{
+	DTEntry root;
+	char const *compat;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", (void const **)&compat, &size) != kSuccess) {
+		return false;
+	}
+	static const char want[] = "google,sunfish";
+	for (unsigned int i = 0; i < size;) {
+		size_t len = strnlen(compat + i, size - i);
+		if (len == sizeof(want) - 1 && memcmp(compat + i, want, len) == 0) {
+			return true;
+		}
+		i += (unsigned int)len + 1u;
+	}
+	return false;
+}
+
+static int
+touch_ftm5_event(uint8_t *ev)
+{
+	return touch_read(FTM5_ADDR, FTM5_READ_EVENT, false, ev, FTM5_EV_SIZE);
+}
+
+/*
+ * ftsCore.c setScanMode(): the vendor driver aborts a stale flash access
+ * ({0xfa,0x20,...}) and then selects the active scan mode with settings 0.
+ * fts_resume() uses the same {0xa0, SCAN_MODE_ACTIVE, 0x00} triple.
+ */
+static int
+touch_ftm5_scan(void)
+{
+	static const uint8_t unlock[7] = {0xfa, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00};
+	static const uint8_t scan[3] = {FTM5_SCAN_MODE, 0x00, 0x00};
+	int first = touch_msg(FTM5_ADDR, unlock, sizeof(unlock), NULL, 0, false);
+	int err = touch_msg(FTM5_ADDR, scan, sizeof(scan), NULL, 0, false);
+	printf("SWEET TOUCH: FTM5 scan mode active err=%d (unlock=%d)\n", err, first);
+	return err;
+}
+
+/* PM6150 GPIO4 -> digital output, high, VIN1, no pull, 2 mA, enabled. */
+static bool
+touch_ftm5_power(void)
+{
+	static const struct {
+		uint16_t reg;
+		uint8_t val;
+	} seq[] = {
+		{0x41, 0x01}, /* DIG_VIN_CTL: power-source = <1> */
+		{0x42, 0x05}, /* DIG_PULL_CTL: bias-disable */
+		{0x45, 0x02}, /* DIG_OUT_CTL: CMOS, qcom,drive-strength = <2> */
+		{0x44, 0x80}, /* LV_MV_DIG_OUT_SOURCE_CTL: "normal", output high */
+		{0x40, 0x01}, /* MODE_CTL: digital output */
+		{0x46, 0x80}, /* EN_CTL: enable */
+	};
+	uint8_t mode = 0xff, src = 0xff, en = 0xff;
+	if (sweet_spmi_init() != 0) {
+		printf("SWEET TOUCH: no SPMI; cannot check the FTM5 load switch\n");
+		return false;
+	}
+	(void)sweet_spmi_read(0, PM6150_GPIO4 + 0x40u, &mode);
+	(void)sweet_spmi_read(0, PM6150_GPIO4 + 0x44u, &src);
+	(void)sweet_spmi_read(0, PM6150_GPIO4 + 0x46u, &en);
+	printf("SWEET TOUCH: PM6150 GPIO4 mode=%#x src=%#x en=%#x\n", mode, src, en);
+	if ((mode & 3u) == 1u && (src & 0x80u) && (en & 0x80u)) {
+		return true; /* ABL already switched the touch rails on */
+	}
+	for (unsigned i = 0; i < sizeof(seq) / sizeof(seq[0]); ++i) {
+		if (sweet_spmi_write(0, PM6150_GPIO4 + seq[i].reg, seq[i].val) != 0) {
+			printf("SWEET TOUCH: PM6150 GPIO4 write %#x failed\n", seq[i].reg);
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Bring-up of the sunfish FTM5. Returns true when sensing is on. */
+static bool
+touch_ftm5_start(void)
+{
+	uint8_t ev[FTM5_EV_SIZE];
+	printf("SWEET TOUCH: sunfish FTM5: TLMM reset=%#x irq=%#x switch=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(72)));
+	touch_gpio(9, 0, 0, 0, false, false);  /* IRQ input, no pull (polled) */
+	touch_gpio(72, 0, 0, 0, true, false);  /* IRQ routed to the AP, not SLPI */
+	touch_gpio(8, 0, 0, 0, true, false);   /* hold in reset while powering */
+	if (!touch_ftm5_power()) {
+		printf("SWEET TOUCH: continuing without the PM6150 GPIO4 write\n");
+	}
+	touch_wait(10);
+	if (st.soft) {
+		/* Open-drain pads; the bus assignment is probed after reset. */
+		sw_release(6);
+		sw_release(7);
+	} else {
+		touch_gpio(6, 1, 0, 0, false, false);  /* qup11 SDA/SCL */
+		touch_gpio(7, 1, 0, 0, false, false);
+	}
+	/* fts_system_reset() with a reset GPIO: low 10 ms, high, poll for READY. */
+	touch_gpio(8, 0, 0, 0, true, true);
+	touch_wait(10);
+	if (st.soft) {
+		if (!touch_soft_bus()) {
+			printf("SWEET TOUCH: FTM5 never acknowledged on TLMM 6/7\n");
+			return false;
+		}
+	}
+	st.probing = true;
+	int err = ENXIO;
+	bool ready = false;
+	for (unsigned i = 0; i < 40 && !ready; ++i) {
+		touch_wait(25);
+		memset(ev, 0, sizeof(ev));
+		err = touch_ftm5_event(ev);
+		if (!err && ev[0] == FTM5_EV_READY) {
+			ready = true;
+		}
+		st.probing = i < 2; /* log the first transfers only */
+	}
+	st.probing = false;
+	printf("SWEET TOUCH: FTM5 0x49 err=%d ready=%d event=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    err, ready, ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+	if (err || st.dead) {
+		return false;
+	}
+	/* Even without a READY event (missed, or reset already done) the IC answers. */
+	return touch_ftm5_scan() == 0;
+}
+
+/*
+ * Drain the FTM5 event FIFO and report contacts. Each 8-byte read pops one
+ * event; byte 7 bits 0-4 count the events still queued (fts_event_handler).
+ */
+/* Rate limit the recovery scan so an error storm cannot flood the console. */
+static bool
+touch_rescan_ready(void)
+{
+	uint64_t now, delta = 0;
+	clock_get_uptime(&now);
+	if (st.last_rescan != 0) {
+		absolutetime_to_nanoseconds(now - st.last_rescan, &delta);
+		if (delta < 250000000ull) {
+			return false;
+		}
+	}
+	st.last_rescan = now;
+	return true;
+}
+
+static int
+touch_ftm5(void)
+{
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	uint8_t ev[FTM5_EV_SIZE];
+	bool rescan = false;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
