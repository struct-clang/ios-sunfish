+/*
+ * sunfish fallback: open-drain I2C on TLMM 6/7. The pads have external
+ * pull-ups in the panel flex; the internal pull-up is left on as well so a
+ * missing population still idles high (at a lower clock). ~100 kHz is far
+ * more than the 8 bytes per 10 ms poll needs.
+ */
+#define SW_HALF_US 5u
+
+static void
+sw_delay(void)
+{
+	delay(SW_HALF_US);
+}
+
+static void
+sw_low(unsigned pin)
+{
+	touch_gpio(pin, 0, 3, 0, true, false);
+}
+
+static void
+sw_release(unsigned pin)
+{
+	touch_gpio(pin, 0, 3, 0, false, false);
+}
+
+static bool
+sw_high(unsigned pin)
+{
+	return (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & 1u) != 0;
+}
+
+/* Release SCL and let the slave stretch it low if it wants to. */
+static bool
+sw_clock_high(void)
+{
+	sw_release(st.scl);
+	for (unsigned i = 0; i < 2000; ++i) {
+		if (sw_high(st.scl)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* START works from idle and from a low SCL after an ACK (repeated START). */
+static void
+sw_start(void)
+{
+	sw_release(st.sda);
+	sw_release(st.scl);
+	sw_delay();
+	sw_low(st.sda);
+	sw_delay();
+	sw_low(st.scl);
+	sw_delay();
+}
+
+static void
+sw_stop(void)
+{
+	sw_low(st.sda);
+	sw_delay();
+	if (!sw_clock_high()) {
+		return;
+	}
+	sw_delay();
+	sw_release(st.sda);
+	sw_delay();
+}
+
+static bool
+sw_write_bit(unsigned bit)
+{
+	if (bit) {
+		sw_release(st.sda);
+	} else {
+		sw_low(st.sda);
+	}
+	sw_delay();
+	if (!sw_clock_high()) {
+		return false;
+	}
+	sw_delay();
+	sw_low(st.scl);
+	sw_delay();
+	return true;
+}
+
+/* Returns the sampled bit, or -1 when the bus is stuck (no pull-up). */
+static int
+sw_read_bit(void)
+{
+	sw_release(st.sda);
+	sw_delay();
+	if (!sw_clock_high()) {
+		return -1;
+	}
+	sw_delay();
+	int bit = sw_high(st.sda) ? 1 : 0;
+	sw_low(st.scl);
+	sw_delay();
+	return bit;
+}
+
+static bool
+sw_write_byte(uint8_t byte)
+{
+	for (unsigned i = 0; i < 8; ++i) {
+		if (!sw_write_bit((byte >> (7u - i)) & 1u)) {
+			return false;
+		}
+	}
+	/* Ninth clock: the slave pulls SDA low to acknowledge. */
+	sw_release(st.sda);
+	sw_delay();
+	if (!sw_clock_high()) {
+		return false;
+	}
+	sw_delay();
+	bool ack = !sw_high(st.sda);
+	sw_low(st.scl);
+	sw_delay();
+	return ack;
+}
+
+static int
+sw_read_byte(bool ack)
+{
+	uint8_t byte = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		int bit = sw_read_bit();
+		if (bit < 0) {
+			return -1;
+		}
+		byte = (uint8_t)((byte << 1) | (bit ? 1u : 0u));
+	}
+	/* Master ACK (continue) or NACK (last byte). */
+	if (ack) {
+		sw_low(st.sda);
+	} else {
+		sw_release(st.sda);
+	}
+	sw_delay();
+	if (!sw_clock_high()) {
+		return -1;
+	}
+	sw_delay();
+	sw_low(st.scl);
+	sw_release(st.sda);
+	sw_delay();
+	return byte;
+}
+
+static int
+sw_xfer(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr)
+{
+	sw_start();
+	if (!sw_write_byte((uint8_t)(addr << 1))) {
+		sw_stop();
+		return EIO;
+	}
+	for (unsigned i = 0; i < nt; ++i) {
+		if (!sw_write_byte(tx[i])) {
+			sw_stop();
+			return EIO;
+		}
+	}
+	if (nr) {
+		sw_start();
+		if (!sw_write_byte((uint8_t)((addr << 1) | 1u))) {
+			sw_stop();
+			return EIO;
+		}
+		for (unsigned i = 0; i < nr; ++i) {
+			int byte = sw_read_byte(i + 1u < nr);
+			if (byte < 0) {
+				sw_stop();
+				return EIO;
+			}
+			rx[i] = (uint8_t)byte;
+		}
+	}
+	sw_stop();
+	return 0;
+}
+
+static bool
+sw_probe(uint8_t addr)
+{
+	sw_start();
+	bool ack = sw_write_byte((uint8_t)(addr << 1));
+	sw_stop();
+	return ack;
+}
+
+/*
+ * The pad-to-lane order is not documented in the device tree, so try both
+ * assignments; only the correct one is acknowledged by the controller.
+ */
+static bool
+touch_soft_bus(void)
+{
+	static const unsigned pairs[2][2] = {{6, 7}, {7, 6}};
+	for (unsigned attempt = 0; attempt < 20 && !st.dead; ++attempt) {
+		for (unsigned p = 0; p < 2; ++p) {
+			st.sda = pairs[p][0];
+			st.scl = pairs[p][1];
+			sw_release(st.sda);
+			sw_release(st.scl);
+			delay(200);
+			if (!sw_high(st.sda) && !sw_high(st.scl)) {
+				continue;
+			}
+			if (sw_probe(FTM5_ADDR)) {
+				printf("SWEET TOUCH: FTM5 ACK on bit-banged I2C sda=%u scl=%u\n",
+				    st.sda, st.scl);
+				return true;
+			}
+		}
+		delay(50);
+	}
+	return false;
+}
