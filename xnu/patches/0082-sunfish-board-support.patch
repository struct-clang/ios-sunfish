diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 1981490..fdd8a07 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -17,9 +17,11 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define SP_CORE_PA 0x0c440000u
 #define SP_OBS_PA  0x0e600000u
 #define SP_CFG_PA  0x0c40a000u
+#define SP_CHNL_PA 0x0c600000u /* "chnls": EE 0 owner channels, 0x10000 per APID */
 #define SP_NO_APID 0xffffu
 
-static vm_offset_t sp_core, sp_obs, sp_cfg;
+static vm_offset_t sp_core, sp_obs, sp_cfg, sp_chnl;
+static uint16_t sp_chnl_apid = SP_NO_APID;
 static IOLock *sp_lock;
 static unsigned sp_count;
 static bool sp_attempted, sp_ready;
@@ -86,11 +88,12 @@ sweet_spmi_init(void)
 int
 sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
-	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	/* Restrict access to the battery blocks (and the sunfish touch switch,
+	 * PM6150 GPIO4); keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
 	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
 	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	    peripheral != 0x13 && peripheral != 0x48 && peripheral != 0xc3)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -123,4 +126,52 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+/*
+ * SUNFISH: the in-cell FTM5 touch IC sits behind a load switch on PM6150
+ * GPIO4 (downstream pinctrl touch_power_default: output high). That pin is
+ * the only PMIC state any SWEET driver changes; the address check below
+ * keeps every other peripheral read-only.
+ */
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
+{
+	if (!sp_ready || sid != 0 || addr < 0xc340u || addr > 0xc346u) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid] ||
+	    (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET SPMI: write sid=%u addr=%#x refused (APID=%u not owned by EE 0)\n",
+		    sid, addr, apid);
+		return -1;
+	}
+	if (sp_chnl_apid != apid) {
+		sp_chnl = ml_io_map(SP_CHNL_PA + 0x10000u * apid, 0x1000);
+		sp_chnl_apid = sp_chnl ? apid : SP_NO_APID;
+	}
+	vm_offset_t chnl = sp_chnl;
+	if (!chnl) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(chnl + 0x10u) = val;    /* WDATA0 */
+	*(volatile uint32_t *)(chnl + 0x00u) = (addr & 0xffu) << 4; /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(chnl, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET SPMI: write timeout sid=%u addr=%#x APID=%u disabled\n", sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
